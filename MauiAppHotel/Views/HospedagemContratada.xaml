<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout VerticalOptions="Center"
                         Spacing="10"
                         Padding="10">
        
        <Label 
            Text="{Binding Path=QuartoEscolhido.Nome}"
            FontFamily="MeaCulpa"
            TextColor="{StaticResource Primary}"
            FontSize="40"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center"/>
        
        <Border StrokeShape="RoundRectangle 10"
        BackgroundColor="{StaticResource SecondaryDarkText}">
            <Grid ColumnDefinitions="*, *" Padding="5" 
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Adultos" />
                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding QntAdultos}" />

                <Label Grid.Row="0" Grid.Column="1" Text="Crianças" />
                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding QntCriancas}" />

            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource SecondaryDarkText}">
            <Grid ColumnDefinitions="*, *, *" Padding="5"       
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Data Checkin:" />
                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding DataCheckin, StringFormat='{}{0:dd/MM/yyyy}'}" />

                <Label Grid.Row="0" Grid.Column="1" Text="Data Checkout:" />
                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding DataCheckout, StringFormat='{}{0:dd/MM/yyyy}'}" />

                <Label Grid.Row="0" Grid.Column="2" Text="Estadia" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}" />

            </Grid>
                
        </Border>

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource SecondaryDarkText}">
            <VerticalStackLayout Padding="5">
                <Label Text="Total Estadia:" />
                <Label Text="{Binding TotalHospedagem, StringFormat='{}{0:C}'}" />                
            </VerticalStackLayout>
        </Border>
        <Button Text="Voltar" HorizontalOptions="Center" Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>